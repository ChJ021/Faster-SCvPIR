+TEST(NegacyclicNttTest, MatchesNaiveExactArithmetic) {
+  ASSERT_OK_AND_ASSIGN(auto ntt, lwe::NegacyclicNtt::Create(kModulus, 3));
+  std::vector<uint32_t> lhs = {
+      0, 1, static_cast<uint32_t>(kModulus - 1), 17, 29, 31, 37, 41};
+  std::vector<uint32_t> rhs = {
+      43, 47, 53, 59, 61, 67, 71, static_cast<uint32_t>(kModulus - 2)};
+  ASSERT_OK_AND_ASSIGN(auto actual, ntt->Multiply(lhs, rhs));
+  EXPECT_EQ(actual, NaiveNegacyclic(lhs, rhs));
+}
+
+TEST(YpirMainPreprocessorTest, HAsAndZaMatchMaterializedPadElementwise) {
+  Parameters params = SmallYpirParameters();
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x5a');
+  ASSERT_OK_AND_ASSIGN(auto preprocessor,
+                       CreateMainPreprocessor(params, seed));
+  ASSERT_OK_AND_ASSIGN(lwe::Matrix pad,
+                       preprocessor->MaterializePadForTesting());
+
+  lwe::Vector secret(params.lwe_secret_dim);
+  for (int i = 0; i < secret.size(); ++i) {
+    secret(i) = i % 3 == 0 ? static_cast<uint32_t>(kModulus - 1)
+                           : static_cast<uint32_t>(i % 2);
+  }
+  ASSERT_OK_AND_ASSIGN(lwe::Vector actual_as,
+                       preprocessor->ComputePadTimesSecret(secret));
+  for (int row = 0; row < params.db_cols; ++row) {
+    uint32_t expected = 0;
+    for (int col = 0; col < params.lwe_secret_dim; ++col) {
+      expected = AddMod(expected, MulMod(pad(row, col), secret(col)));
+    }
+    EXPECT_EQ(actual_as(row), expected) << "As row " << row;
+  }
+
+  VMatrix left(3, params.db_cols);
+  for (uint64_t row = 0; row < left.rows; ++row) {
+    for (uint64_t col = 0; col < left.cols; ++col) {
+      left.data[row * left.cols + col] =
+          static_cast<uint32_t>(13 * row + 7 * col + 3);
+    }
+  }
+  ASSERT_OK_AND_ASSIGN(VMatrix actual_za,
+                       preprocessor->MultiplyRightByPad(left));
+  for (uint64_t row = 0; row < left.rows; ++row) {
+    for (int col = 0; col < params.lwe_secret_dim; ++col) {
+      uint32_t expected = 0;
+      for (int k = 0; k < params.db_cols; ++k) {
+        expected = AddMod(
+            expected, MulMod(left.getElem(row, k), pad(k, col)));
+      }
+      EXPECT_EQ(actual_za.getElem(row, col), expected)
+          << "ZA(" << row << "," << col << ")";
+    }
+  }
+
+  ASSERT_OK_AND_ASSIGN(auto database, Database::CreateFast(params));
+  ASSERT_OK_AND_ASSIGN(auto actual_hints,
+                       preprocessor->ComputeHint(*database));
+  ASSERT_OK_AND_ASSIGN(
+      auto expected_hints,
+      database->DirectMatrixProduct(ImportLweMatrix(pad)));
+  ASSERT_EQ(actual_hints.size(), expected_hints.size());
+  for (size_t shard = 0; shard < actual_hints.size(); ++shard) {
+    ASSERT_EQ(actual_hints[shard].size(), expected_hints[shard].size());
+    for (size_t row = 0; row < actual_hints[shard].size(); ++row) {
+      EXPECT_EQ(actual_hints[shard][row], expected_hints[shard][row])
+          << "H shard " << shard << ", row " << row;
+    }
+  }
+
+  MainPreprocessorMetadata metadata = preprocessor->Metadata();
+  EXPECT_EQ(metadata.backend, MainPreprocessorBackend::kYpirNtt);
+  EXPECT_EQ(metadata.ring_degree, 8);
+  EXPECT_EQ(metadata.pad_block_count, 2);
+  EXPECT_EQ(metadata.modulus, kModulus);
+  EXPECT_EQ(metadata.prg_domain, kYpirMainPadDomain);
+}
+
+TEST(YpirMainPreprocessorTest, RejectsSilentDimensionTruncation) {
+  Parameters params = SmallYpirParameters();
+  params.lwe_secret_dim = 7;
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x3c');
+  EXPECT_THAT(DescribeMainPreprocessor(params),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  EXPECT_THAT(CreateMainPreprocessor(params, seed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
+
+TEST(MainPreprocessorMetadataTest, DescriptionMatchesConstructedBackend) {
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x19');
+
+  Parameters ypir_params = SmallYpirParameters();
+  ASSERT_OK_AND_ASSIGN(auto ypir_description,
+                       DescribeMainPreprocessor(ypir_params));
+  ASSERT_OK_AND_ASSIGN(auto ypir,
+                       CreateMainPreprocessor(ypir_params, seed));
+  ExpectMetadataEqual(ypir_description, ypir->Metadata());
+
+  Parameters dense_params = ypir_params;
+  dense_params.main_preprocessor_backend = MainPreprocessorBackend::kDenseLwe;
+  ASSERT_OK_AND_ASSIGN(auto dense_description,
+                       DescribeMainPreprocessor(dense_params));
+  ASSERT_OK_AND_ASSIGN(auto dense,
+                       CreateMainPreprocessor(dense_params, seed));
+  ExpectMetadataEqual(dense_description, dense->Metadata());
+}
+
+TEST(YpirMainPreprocessorTest, PadsAreNonzeroAndDomainSeparated) {
+  Parameters ypir_params = SmallYpirParameters();
+  Parameters dense_params = ypir_params;
+  dense_params.main_preprocessor_backend = MainPreprocessorBackend::kDenseLwe;
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x27');
+
+  ASSERT_OK_AND_ASSIGN(auto ypir, CreateMainPreprocessor(ypir_params, seed));
+  ASSERT_OK_AND_ASSIGN(auto dense, CreateMainPreprocessor(dense_params, seed));
+  ASSERT_OK_AND_ASSIGN(lwe::Matrix ypir_pad,
+                       ypir->MaterializePadForTesting());
+  ASSERT_OK_AND_ASSIGN(lwe::Matrix dense_pad,
+                       dense->MaterializePadForTesting());
+
+  bool ypir_has_nonzero = false;
+  bool dense_has_nonzero = false;
+  bool pads_differ = false;
+  for (int row = 0; row < ypir_params.db_cols; ++row) {
+    for (int col = 0; col < ypir_params.lwe_secret_dim; ++col) {
+      ypir_has_nonzero |= ypir_pad(row, col) != 0;
+      dense_has_nonzero |= dense_pad(row, col) != 0;
+      pads_differ |= ypir_pad(row, col) != dense_pad(row, col);
+    }
+  }
+  EXPECT_TRUE(ypir_has_nonzero);
+  EXPECT_TRUE(dense_has_nonzero);
+  EXPECT_TRUE(pads_differ);
+}
