+namespace {
+
+absl::Status ValidateMainPreprocessorMetadata(
+    const MainPreprocessorMetadata& expected,
+    const HintlessPirServerPublicParams& public_params) {
+  if (!public_params.has_main_preprocessor_backend()) {
+    if (expected.backend == MainPreprocessorBackend::kDenseLwe) {
+      return absl::OkStatus();
+    }
+    return absl::InvalidArgumentError(
+        "YPIR main public parameters are missing backend metadata");
+  }
+  const SerializedMainPreprocessorBackend expected_backend =
+      expected.backend == MainPreprocessorBackend::kYpirNtt
+          ? MAIN_PREPROCESSOR_YPIR_NTT
+          : MAIN_PREPROCESSOR_DENSE_LWE;
+  if (public_params.main_preprocessor_backend() != expected_backend ||
+      public_params.main_ring_degree() != expected.ring_degree ||
+      public_params.main_pad_block_count() != expected.pad_block_count ||
+      public_params.structured_pad_version() !=
+          expected.structured_pad_version ||
+      public_params.main_modulus() != expected.modulus ||
+      public_params.main_secret_dimension() != expected.secret_dimension ||
+      public_params.main_prg_domain() != expected.prg_domain ||
+      public_params.main_security_status() != expected.security_status) {
+    return absl::InvalidArgumentError(
+        "main preprocessing metadata does not match client parameters");
+  }
+  return absl::OkStatus();
+}
+
+}  // namespace
