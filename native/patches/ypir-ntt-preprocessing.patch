+constexpr uint64_t kModulus = SOL_NTT_PRIME;
+
+uint32_t AddMod(uint32_t lhs, uint32_t rhs) {
+  uint64_t sum = static_cast<uint64_t>(lhs) + rhs;
+  return static_cast<uint32_t>(sum >= kModulus ? sum - kModulus : sum);
+}
+
+uint32_t MulMod(uint32_t lhs, uint32_t rhs) {
+  return static_cast<uint32_t>((static_cast<uint64_t>(lhs) * rhs) %
+                               kModulus);
+}
+
+std::vector<uint32_t> NaiveNegacyclic(
+    const std::vector<uint32_t>& lhs, const std::vector<uint32_t>& rhs) {
+  const int degree = lhs.size();
+  std::vector<uint32_t> output(degree, 0);
+  for (int i = 0; i < degree; ++i) {
+    for (int j = 0; j < degree; ++j) {
+      uint32_t term = MulMod(lhs[i], rhs[j]);
+      int index = i + j;
+      if (index >= degree) {
+        index -= degree;
+        term = term == 0 ? 0 : static_cast<uint32_t>(kModulus - term);
+      }
+      output[index] = AddMod(output[index], term);
+    }
+  }
+  return output;
+}
+
+Parameters SmallYpirParameters() {
+  Parameters params{};
+  params.db_rows = 4;
+  params.db_cols = 16;
+  params.db_record_bit_size = 8;
+  params.lwe_secret_dim = 8;
+  params.offline_lwe_secret_dim = 8;
+  params.lwe_modulus_bit_size = 32;
+  params.lwe_plaintext_bit_size = 8;
+  params.db_stack_cells = 1;
+  params.lwe_error_variance = 8;
+  params.prng_type = rlwe::PRNG_TYPE_HKDF;
+  params.main_preprocessor_backend = MainPreprocessorBackend::kYpirNtt;
+  params.main_ring_log_n = 3;
+  params.main_pad_block_count = 2;
+  params.structured_pad_version = kYpirStructuredPadVersion;
+  return params;
+}
+
+void ExpectMetadataEqual(const MainPreprocessorMetadata& lhs,
+                         const MainPreprocessorMetadata& rhs) {
+  EXPECT_EQ(lhs.backend, rhs.backend);
+  EXPECT_EQ(lhs.backend_name, rhs.backend_name);
+  EXPECT_EQ(lhs.ring_degree, rhs.ring_degree);
+  EXPECT_EQ(lhs.pad_block_count, rhs.pad_block_count);
+  EXPECT_EQ(lhs.structured_pad_version, rhs.structured_pad_version);
+  EXPECT_EQ(lhs.modulus, rhs.modulus);
+  EXPECT_EQ(lhs.secret_dimension, rhs.secret_dimension);
+  EXPECT_EQ(lhs.prg_domain, rhs.prg_domain);
+  EXPECT_EQ(lhs.security_status, rhs.security_status);
+}
