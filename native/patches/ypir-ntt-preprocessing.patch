+// Copyright 2026
+// Licensed under the Apache License, Version 2.0.
+
+#include "hintless_simplepir/offline_preprocessor.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "hintless_simplepir/database_hwy.h"
+#include "hintless_simplepir/parameters.h"
+#include "lwe/matrix_conversion.h"
+#include "lwe/negacyclic_ntt.h"
+#include "shell_encryption/prng/single_thread_hkdf_prng.h"
+#include "shell_encryption/testing/status_matchers.h"
+#include "shell_encryption/testing/status_testing.h"
+#include "verisimplepir/src/lib/pir/lhe.h"
+#include "verisimplepir/src/lib/pir/mat.h"
+
+namespace hintless_pir {
+namespace hintless_simplepir {
+namespace {
+
+using ::rlwe::testing::StatusIs;
+
+constexpr uint64_t kModulus = VSPIR_LHE_PRIME;
+
+uint64_t AddMod(uint64_t lhs, uint64_t rhs) {
+  const uint64_t sum = lhs + rhs;
+  return sum >= kModulus ? sum - kModulus : sum;
+}
+
+uint64_t MulMod(uint64_t lhs, uint64_t rhs) {
+  return static_cast<uint64_t>(
+      (static_cast<unsigned __int128>(lhs) * rhs) % kModulus);
+}
+
+std::vector<uint64_t> NaiveNegacyclic(
+    const std::vector<uint64_t>& lhs, const std::vector<uint64_t>& rhs) {
+  const int degree = lhs.size();
+  std::vector<uint64_t> output(degree, 0);
+  for (int i = 0; i < degree; ++i) {
+    for (int j = 0; j < degree; ++j) {
+      uint64_t term = MulMod(lhs[i], rhs[j]);
+      int index = i + j;
+      if (index >= degree) {
+        index -= degree;
+        term = term == 0 ? 0 : kModulus - term;
+      }
+      output[index] = AddMod(output[index], term);
+    }
+  }
+  return output;
+}
+
+Parameters SmallOfflineParameters() {
+  Parameters params{};
+  params.db_rows = 16;
+  params.db_cols = 7;
+  params.db_record_bit_size = 8;
+  params.lwe_secret_dim = 8;
+  params.offline_lwe_secret_dim = 8;
+  params.lwe_modulus_bit_size = 32;
+  params.lwe_plaintext_bit_size = 8;
+  params.db_stack_cells = 1;
+  params.lwe_error_variance = 8;
+  params.prng_type = rlwe::PRNG_TYPE_HKDF;
+  params.offline_preprocessor_backend =
+      OfflinePreprocessorBackend::kYpirNtt;
+  params.offline_ring_log_n = 3;
+  params.offline_pad_block_count = 2;
+  params.offline_structured_pad_version =
+      kYpirOfflineStructuredPadVersion;
+  return params;
+}
+
+TEST(NegacyclicNtt64Test, MatchesNaiveExactArithmeticAbove32Bits) {
+  ASSERT_OK_AND_ASSIGN(auto ntt, lwe::NegacyclicNtt::Create(kModulus, 3));
+  std::vector<uint64_t> lhs = {
+      0, 1, kModulus - 1, uint64_t{1} << 40,
+      (uint64_t{1} << 48) + 17, 31, kModulus - 37, 41};
+  std::vector<uint64_t> rhs = {
+      43, uint64_t{1} << 33, 53, kModulus - 59,
+      (uint64_t{1} << 45) + 61, 67, 71, kModulus - 2};
+  ASSERT_OK_AND_ASSIGN(auto actual, ntt->Multiply64(lhs, rhs));
+  EXPECT_EQ(actual, NaiveNegacyclic(lhs, rhs));
+}
+
+TEST(YpirOfflinePreprocessorTest,
+     H2AndPadProductMatchDenseMaterializationElementwise) {
+  const Parameters params = SmallOfflineParameters();
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x5a');
+  ASSERT_OK_AND_ASSIGN(auto preprocessor,
+                       YpirOfflinePreprocessor::Create(params, seed));
+  ASSERT_OK_AND_ASSIGN(Matrix64 pad,
+                       preprocessor->MaterializePadForTesting());
+
+  Matrix64 secret(params.offline_lwe_secret_dim, 1);
+  for (uint64_t i = 0; i < secret.rows; ++i) {
+    secret.data[i] = i % 3 == 0 ? kModulus - 1 : i % 2;
+  }
+  ASSERT_OK_AND_ASSIGN(Matrix64 actual_as,
+                       preprocessor->ComputePadTimesSecret(secret));
+  for (uint64_t row = 0; row < pad.rows; ++row) {
+    uint64_t expected = 0;
+    for (uint64_t col = 0; col < pad.cols; ++col) {
+      expected = AddMod(
+          expected, MulMod(pad.data[row * pad.cols + col], secret.data[col]));
+    }
+    EXPECT_EQ(actual_as.data[row], expected) << "A2*s row " << row;
+  }
+
+  ASSERT_OK_AND_ASSIGN(auto database, Database::CreateFast(params));
+  ASSERT_OK_AND_ASSIGN(auto actual_hints,
+                       preprocessor->ComputeHint(*database));
+  const Database::LweMatrix64 pad_columns =
+      convertToHintlessPIRMatrixColumnForm64(
+          pad, params.db_rows, params.offline_lwe_secret_dim);
+  ASSERT_OK_AND_ASSIGN(auto expected_hints,
+                       database->TransposeMatrixProduct64(pad_columns));
+  EXPECT_EQ(actual_hints, expected_hints);
+
+  const OfflinePreprocessorMetadata metadata = preprocessor->Metadata();
+  EXPECT_EQ(metadata.backend, OfflinePreprocessorBackend::kYpirNtt);
+  EXPECT_EQ(metadata.ring_degree, 8);
+  EXPECT_EQ(metadata.pad_block_count, 2);
+  EXPECT_EQ(metadata.modulus, kModulus);
+  EXPECT_EQ(metadata.prg_domain, kYpirOfflinePadDomain);
+}
+
+TEST(YpirOfflinePreprocessorTest, EncryptsChallengesWithStructuredPad) {
+  const Parameters params = SmallOfflineParameters();
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x27');
+  ASSERT_OK_AND_ASSIGN(auto preprocessor,
+                       YpirOfflinePreprocessor::Create(params, seed));
+  ASSERT_OK_AND_ASSIGN(Matrix64 pad,
+                       preprocessor->MaterializePadForTesting());
+
+  BinaryMatrix challenges(2, params.db_rows);
+  for (uint64_t row = 0; row < challenges.rows; ++row) {
+    for (uint64_t col = 0; col < challenges.cols; ++col) {
+      challenges.data[row * challenges.cols + col] = (row + col) % 3 == 0;
+    }
+  }
+  LHE lhe(/*p_in=*/2, /*r_in=*/1);
+  ASSERT_OK_AND_ASSIGN(auto encrypted,
+                       preprocessor->EncryptChallenges(lhe, challenges));
+  ASSERT_EQ(encrypted.first.size(), challenges.rows);
+  ASSERT_EQ(encrypted.second.size(), challenges.rows);
+  for (uint64_t row = 0; row < challenges.rows; ++row) {
+    EXPECT_EQ(encrypted.second[row].rows,
+              static_cast<uint64_t>(params.offline_lwe_secret_dim));
+    Matrix decoded = lhe.decrypt_preproc64(
+        pad, encrypted.second[row], encrypted.first[row], /*blowup=*/1,
+        /*preproc=*/true);
+    ASSERT_EQ(decoded.rows, challenges.cols);
+    for (uint64_t col = 0; col < challenges.cols; ++col) {
+      EXPECT_EQ(decoded.data[col],
+                static_cast<Elem>(
+                    challenges.data[row * challenges.cols + col]))
+          << "challenge (" << row << "," << col << ")";
+    }
+  }
+}
+
+TEST(YpirOfflinePreprocessorTest, IsDeterministicAndRejectsDimensionDrift) {
+  Parameters params = SmallOfflineParameters();
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x3c');
+  ASSERT_OK_AND_ASSIGN(auto first,
+                       YpirOfflinePreprocessor::Create(params, seed));
+  ASSERT_OK_AND_ASSIGN(auto second,
+                       YpirOfflinePreprocessor::Create(params, seed));
+  ASSERT_OK_AND_ASSIGN(Matrix64 first_pad,
+                       first->MaterializePadForTesting());
+  ASSERT_OK_AND_ASSIGN(Matrix64 second_pad,
+                       second->MaterializePadForTesting());
+  ASSERT_EQ(first_pad.rows * first_pad.cols,
+            second_pad.rows * second_pad.cols);
+  for (uint64_t i = 0; i < first_pad.rows * first_pad.cols; ++i) {
+    EXPECT_EQ(first_pad.data[i], second_pad.data[i]);
+  }
+
+  params.offline_lwe_secret_dim = 7;
+  EXPECT_THAT(YpirOfflinePreprocessor::Create(params, seed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  params = SmallOfflineParameters();
+  params.db_rows = 15;
+  EXPECT_THAT(YpirOfflinePreprocessor::Create(params, seed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  params = SmallOfflineParameters();
+  params.offline_pad_block_count = 1;
+  EXPECT_THAT(YpirOfflinePreprocessor::Create(params, seed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
+
+TEST(YpirOfflinePreprocessorTest, InitializesBothExperimentRingDegrees) {
+  const std::string seed(rlwe::SingleThreadHkdfPrng::SeedLength(), '\x11');
+  for (int log_degree : {11, 12}) {
+    Parameters params = SmallOfflineParameters();
+    params.db_rows = 4096;
+    params.offline_ring_log_n = log_degree;
+    params.offline_lwe_secret_dim = 1 << log_degree;
+    params.offline_pad_block_count = params.db_rows >> log_degree;
+    ASSERT_OK_AND_ASSIGN(auto preprocessor,
+                         YpirOfflinePreprocessor::Create(params, seed));
+    EXPECT_EQ(preprocessor->Metadata().ring_degree, 1 << log_degree);
+  }
+}
