+
   return absl::WrapUnique(
       new Client(params, public_params.prng_seed_lwe_query_pad(),
                  std::move(rlwe_contexts), std::move(rlwe_moduli),
-                 std::move(linpir_clients), std::move(crt_context)));
+                 std::move(linpir_clients), std::move(crt_context),
