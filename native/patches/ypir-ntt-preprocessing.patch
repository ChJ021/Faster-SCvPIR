+// Copyright 2026
+//
+// Targeted validation for the BFV parameter profile used by Small-Client PIR.
+// This is intentionally not an end-to-end PIR test: it exercises the exact
+// packing, evaluation-key reconstruction, gadget decomposition, rotations,
+// plaintext absorbs, and BSGS depth that determine BFV correctness.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <iomanip>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <boost/multiprecision/cpp_int.hpp>
+#include <gmock/gmock.h>
+#include <gtest/gtest.h>
+#include "absl/numeric/int128.h"
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "absl/strings/string_view.h"
+#include "shell_encryption/integral_types.h"
+#include "shell_encryption/montgomery.h"
+#include "shell_encryption/prng/single_thread_hkdf_prng.h"
+#include "shell_encryption/rns/crt_interpolation.h"
+#include "shell_encryption/rns/finite_field_encoder.h"
+#include "shell_encryption/rns/rns_bfv_ciphertext.h"
+#include "shell_encryption/rns/rns_context.h"
+#include "shell_encryption/rns/rns_error_params.h"
+#include "shell_encryption/rns/rns_gadget.h"
+#include "shell_encryption/rns/rns_galois_key.h"
+#include "shell_encryption/rns/rns_polynomial.h"
+#include "shell_encryption/rns/rns_secret_key.h"
+#include "shell_encryption/status_macros.h"
+#include "shell_encryption/testing/status_testing.h"
+
+namespace hintless_pir {
+namespace linpir {
+namespace {
+
+using Integer = rlwe::Uint64;
+using ModularInt = rlwe::MontgomeryInt<Integer>;
+using Context = rlwe::RnsContext<ModularInt>;
+using Encoder = rlwe::FiniteFieldEncoder<ModularInt>;
+using ErrorParams = rlwe::RnsErrorParams<ModularInt>;
+using Gadget = rlwe::RnsGadget<ModularInt>;
+using GaloisKey = rlwe::RnsGaloisKey<ModularInt>;
+using Polynomial = rlwe::RnsPolynomial<ModularInt>;
+using Ciphertext = rlwe::RnsBfvCiphertext<ModularInt>;
+using SecretKey = rlwe::RnsRlweSecretKey<ModularInt>;
+using PrimeModulus = rlwe::PrimeModulus<ModularInt>;
+using Int256 = boost::multiprecision::int256_t;
+using Uint256 = boost::multiprecision::uint256_t;
+
+constexpr int kLogN = 12;
+constexpr int kN = 1 << kLogN;
+constexpr int kSlotGroupSize = kN / 2;
+constexpr Integer kQ0 = 19988226643746817ULL;
+constexpr Integer kQ1 = 19988226643402753ULL;
+constexpr Integer kT = 4278255617ULL;
+constexpr int kVariance = 8;
+constexpr int kLogGadgetBase0 = 13;
+constexpr int kLogGadgetBase1 = 14;
+constexpr int kExpectedGadgetDimension = 9;
+
+// Exact 1 GiB BSGS evaluation shape: 2,048 rows per block, 1,024 logical
+// rotations, split into 128 baby steps and 8 giant steps.
+constexpr int kRowsPerBlock = 2048;
+constexpr int kDataColumns = 1408;
+constexpr int kBabySteps = 128;
+constexpr int kGiantSteps = 8;
+
+constexpr absl::string_view kSecretSeed =
+    "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdea";
+constexpr absl::string_view kEncryptionSeed =
+    "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdeb";
+constexpr absl::string_view kBabyKeySeed =
+    "2123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdec";
+constexpr absl::string_view kGiantKeySeed =
+    "3123456789abcdef0123456789abcdef0123456789abcdef0123456789abcded";
+
+struct NoiseStats {
+  Uint256 max_scaled_abs;
+  long double scaled_rms;
+  int exact_rounding_mismatches;
+};
+
+long double ToLongDouble(absl::uint128 value) {
+  return std::ldexp(static_cast<long double>(absl::Uint128High64(value)), 64) +
+         static_cast<long double>(absl::Uint128Low64(value));
+}
+
+int ModPow(int base, int exponent, int modulus) {
+  int result = 1;
+  while (exponent > 0) {
+    if ((exponent & 1) != 0) {
+      result = static_cast<int>((static_cast<int64_t>(result) * base) % modulus);
+    }
+    base = static_cast<int>((static_cast<int64_t>(base) * base) % modulus);
+    exponent >>= 1;
+  }
+  return result;
+}
+
+std::vector<Integer> RotateSlotsLeft(const std::vector<Integer>& slots,
+                                     int offset) {
+  std::vector<Integer> rotated(kN);
+  offset %= kSlotGroupSize;
+  for (int group = 0; group < 2; ++group) {
+    const int begin = group * kSlotGroupSize;
+    for (int i = 0; i < kSlotGroupSize; ++i) {
+      rotated[begin + i] = slots[begin + (i + offset) % kSlotGroupSize];
+    }
+  }
+  return rotated;
+}
+
+void FusedSlotMulAdd(std::vector<Integer>* accumulator,
+                     const std::vector<Integer>& lhs,
+                     const std::vector<Integer>& rhs) {
+  for (int i = 0; i < kN; ++i) {
+    absl::uint128 value = (*accumulator)[i];
+    value += absl::uint128(lhs[i]) * rhs[i];
+    (*accumulator)[i] = static_cast<Integer>(value % kT);
+  }
+}
+
+// SplitMix64 is used only to make a fixed, reproducible, full-width plaintext
+// workload. It is not used as cryptographic randomness.
+Integer DataValue(int row, int column) {
+  uint64_t value = (static_cast<uint64_t>(row) << 32) |
+                   static_cast<uint32_t>(column);
+  value += 0x9e3779b97f4a7c15ULL;
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+  value ^= value >> 31;
+  return value % kT;
+}
+
+std::vector<Integer> BuildPackedQuery() {
+  std::vector<Integer> query(kDataColumns);
+  for (int i = 0; i < kDataColumns; ++i) {
+    const int centered = (i * 17 + 3) % 7 - 3;
+    query[i] = centered < 0 ? kT - static_cast<Integer>(-centered)
+                            : static_cast<Integer>(centered);
+  }
+
+  std::vector<Integer> slots(kN, 0);
+  constexpr int kNumRotations = kRowsPerBlock / 2;
+  for (int i = 0; i < kSlotGroupSize; ++i) {
+    if (i < query.size()) {
+      slots[i] = query[i];
+    }
+    const int second_index = (kNumRotations + i) % kSlotGroupSize;
+    if (second_index < query.size()) {
+      slots[kSlotGroupSize + i] = query[second_index];
+    }
+  }
+  return slots;
+}
+
+std::vector<Integer> BuildDiagonalSlots(int giant_id, int baby_id) {
+  std::vector<Integer> slots(kN, 0);
+  const int diagonal = giant_id * kBabySteps + baby_id;
+  for (int k = 0; k < kSlotGroupSize; ++k) {
+    const int row = k % kRowsPerBlock;
+    const int first_column = (k + diagonal) % kSlotGroupSize;
+    if (first_column < kDataColumns) {
+      slots[k] = DataValue(row, first_column);
+    }
+    const int second_column =
+        (kRowsPerBlock / 2 + k + diagonal) % kSlotGroupSize;
+    if (second_column < kDataColumns) {
+      slots[kSlotGroupSize + k] = DataValue(row, second_column);
+    }
+  }
+
+  // Database::CreateBSGS substitutes each diagonal by 5^(-giant_id*128).
+  const int right_rotation = giant_id * kBabySteps;
+  return RotateSlotsLeft(slots, kSlotGroupSize - right_rotation);
+}
+
+absl::StatusOr<GaloisKey> CreateRoundTrippedEvaluationKey(
+    const SecretKey& secret_key, int power, absl::string_view seed,
+    const Gadget* gadget,
+    const std::vector<const PrimeModulus*>& moduli) {
+  RLWE_ASSIGN_OR_RETURN(
+      std::vector<Polynomial> client_pads,
+      GaloisKey::SampleRandomPad(gadget->Dimension(), kLogN, moduli, seed,
+                                 rlwe::PRNG_TYPE_HKDF));
+  RLWE_ASSIGN_OR_RETURN(
+      GaloisKey client_key,
+      GaloisKey::CreateWithRandomPadForBfv(
+          std::move(client_pads), secret_key, power, kVariance, gadget, seed,
+          rlwe::PRNG_TYPE_HKDF));
+
+  // The deployed protocol transmits only the b-components. Exercise their
+  // serialization and server-side reconstruction from the shared pad seed.
+  std::vector<Polynomial> server_key_bs;
+  server_key_bs.reserve(client_key.GetKeyB().size());
+  for (const Polynomial& key_b : client_key.GetKeyB()) {
+    RLWE_ASSIGN_OR_RETURN(auto serialized, key_b.Serialize(moduli));
+    RLWE_ASSIGN_OR_RETURN(Polynomial deserialized,
+                          Polynomial::Deserialize(serialized, moduli));
+    server_key_bs.push_back(std::move(deserialized));
+  }
+  RLWE_ASSIGN_OR_RETURN(
+      std::vector<Polynomial> server_pads,
+      GaloisKey::SampleRandomPad(gadget->Dimension(), kLogN, moduli, seed,
+                                 rlwe::PRNG_TYPE_HKDF));
+  return GaloisKey::CreateFromKeyComponents(
+      std::move(server_pads), std::move(server_key_bs), power, gadget, moduli,
+      seed, rlwe::PRNG_TYPE_HKDF);
+}
+
+absl::StatusOr<Ciphertext> RotateWithPrecomputedPad(
+    const Ciphertext& ciphertext, int power, const GaloisKey& galois_key,
+    const Gadget* gadget,
+    const std::vector<const PrimeModulus*>& moduli) {
+  RLWE_ASSIGN_OR_RETURN(Polynomial c1, ciphertext.Component(1));
+  RLWE_ASSIGN_OR_RETURN(Polynomial c1_sub, c1.Substitute(power, moduli));
+  RLWE_RETURN_IF_ERROR(c1_sub.ConvertToCoeffForm(moduli));
+  RLWE_ASSIGN_OR_RETURN(std::vector<Polynomial> digits,
+                        gadget->Decompose(c1_sub, moduli));
+  if (digits.size() != gadget->Dimension()) {
+    return absl::InternalError("gadget decomposition dimension mismatch");
+  }
+  for (Polynomial& digit : digits) {
+    RLWE_RETURN_IF_ERROR(digit.ConvertToNttForm(moduli));
+  }
+  RLWE_ASSIGN_OR_RETURN(Polynomial next_pad,
+                        galois_key.PrecomputeRandomPad(digits));
+  RLWE_ASSIGN_OR_RETURN(Ciphertext substituted,
+                        ciphertext.Substitute(power));
+  return galois_key.ApplyToWithRandomPad(substituted, digits,
+                                         std::move(next_pad));
+}
+
+absl::StatusOr<NoiseStats> MeasureNoise(
+    const Ciphertext& ciphertext, const std::vector<Integer>& expected_slots,
+    const SecretKey& secret_key, const Encoder& encoder, const Context& context,
+    const std::vector<const PrimeModulus*>& moduli) {
+  RLWE_ASSIGN_OR_RETURN(Polynomial noisy_plaintext, ciphertext.Component(0));
+  RLWE_ASSIGN_OR_RETURN(Polynomial c1, ciphertext.Component(1));
+  RLWE_RETURN_IF_ERROR(
+      noisy_plaintext.FusedMulAddInPlace(c1, secret_key.Key(), moduli));
+  RLWE_RETURN_IF_ERROR(noisy_plaintext.ConvertToCoeffForm(moduli));
+  RLWE_ASSIGN_OR_RETURN(
+      Polynomial plaintext,
+      encoder.EncodeBfv(expected_slots, moduli, /*is_scaled=*/false));
+  RLWE_RETURN_IF_ERROR(plaintext.ConvertToCoeffForm(moduli));
+
+  const int level = moduli.size() - 1;
+  std::vector<Uint256> modulus_hats =
+      rlwe::RnsModulusComplements<ModularInt, Uint256>(moduli);
+  RLWE_ASSIGN_OR_RETURN(std::vector<ModularInt> modulus_hat_invs,
+                        context.MainPrimeModulusCrtFactors(level));
+  RLWE_ASSIGN_OR_RETURN(
+      std::vector<Uint256> coefficients,
+      (rlwe::CrtInterpolation<ModularInt, Uint256>(
+          noisy_plaintext.Coeffs(), moduli, modulus_hats,
+          modulus_hat_invs)));
+
+  const Uint256 modulus = Uint256(kQ0) * kQ1;
+  const Uint256 scaled_modulus = modulus * kT;
+  Uint256 max_scaled_abs = 0;
+  long double sum_squares = 0;
+  int exact_rounding_mismatches = 0;
+  const auto* mod_params_q0 = moduli[0]->ModParams();
+  for (int i = 0; i < coefficients.size(); ++i) {
+    const Integer message =
+        plaintext.Coeffs()[0][i].ExportInt(mod_params_q0);
+    // BFV decoding computes round((t/Q)*a) mod t. For expected coefficient m,
+    // its exact decision residual is t*a-Q*m, centered modulo t*Q. int256 is
+    // required because t*a has about 140 bits for this profile.
+    Int256 residual = Int256(kT) * Int256(coefficients[i]) -
+                      Int256(modulus) * message;
+    residual %= Int256(scaled_modulus);
+    if (residual < 0) {
+      residual += Int256(scaled_modulus);
+    }
+    const Uint256 positive = Uint256(residual);
+    const Uint256 centered = std::min(positive, scaled_modulus - positive);
+    const Uint256 exact_decoded =
+        ((Uint256(kT) * coefficients[i] + modulus / 2) /
+         modulus) %
+        kT;
+    if (exact_decoded != message) {
+      ++exact_rounding_mismatches;
+    }
+    max_scaled_abs = std::max(max_scaled_abs, centered);
+    const long double as_double = centered.convert_to<long double>();
+    sum_squares += as_double * as_double;
+  }
+  return NoiseStats{max_scaled_abs,
+                    std::sqrt(sum_squares / coefficients.size()),
+                    exact_rounding_mismatches};
+}
+
+TEST(BfvParameters, ProductionShapeCorrectnessAndNoise) {
+  const std::vector<Integer> qs{kQ0, kQ1};
+  ASSERT_EQ((kQ0 - 1) % (2 * kN), 0);
+  ASSERT_EQ((kQ1 - 1) % (2 * kN), 0);
+
+  ASSERT_OK_AND_ASSIGN(
+      Context context,
+      Context::CreateForBfvFiniteFieldEncoding(kLogN, qs, /*ps=*/{}, kT));
+  const std::vector<const PrimeModulus*> moduli = context.MainPrimeModuli();
+  ASSERT_OK_AND_ASSIGN(Encoder encoder, Encoder::Create(&context));
+  ASSERT_OK_AND_ASSIGN(
+      ErrorParams error_params,
+      ErrorParams::Create(kLogN, moduli, /*aux_moduli=*/{},
+                          static_cast<int>(std::log2(static_cast<double>(kT))),
+                          std::sqrt(kVariance)));
+
+  const int level = moduli.size() - 1;
+  ASSERT_OK_AND_ASSIGN(auto q_hats,
+                       context.MainPrimeModulusComplements(level));
+  ASSERT_OK_AND_ASSIGN(auto q_hat_invs,
+                       context.MainPrimeModulusCrtFactors(level));
+  const std::vector<size_t> log_gadget_bases{kLogGadgetBase0,
+                                              kLogGadgetBase1};
+  ASSERT_OK_AND_ASSIGN(
+      Gadget gadget,
+      Gadget::Create(kLogN, log_gadget_bases, q_hats, q_hat_invs, moduli));
+  ASSERT_EQ(gadget.Dimension(), kExpectedGadgetDimension);
+
+  // Full-slot round trip includes 0, 1, t-1 and deterministic field values.
+  std::vector<Integer> packing_slots(kN);
+  for (int i = 0; i < kN; ++i) {
+    packing_slots[i] = DataValue(i, i ^ 0x155);
+  }
+  packing_slots[0] = 0;
+  packing_slots[1] = 1;
+  packing_slots[2] = kT - 1;
+  ASSERT_OK_AND_ASSIGN(Polynomial packed,
+                       encoder.EncodeBfv(packing_slots, moduli));
+  ASSERT_OK_AND_ASSIGN(std::vector<Integer> unpacked,
+                       encoder.DecodeBfv(packed, moduli));
+  ASSERT_EQ(unpacked, packing_slots);
+
+  ASSERT_OK_AND_ASSIGN(auto secret_prng,
+                       rlwe::SingleThreadHkdfPrng::Create(kSecretSeed));
+  ASSERT_OK_AND_ASSIGN(
+      SecretKey secret_key,
+      SecretKey::Sample(kLogN, kVariance, moduli, secret_prng.get()));
+  ASSERT_OK_AND_ASSIGN(auto encryption_prng,
+                       rlwe::SingleThreadHkdfPrng::Create(kEncryptionSeed));
+
+  const std::vector<Integer> query_slots = BuildPackedQuery();
+  ASSERT_OK_AND_ASSIGN(
+      Ciphertext encrypted_query,
+      secret_key.EncryptBfv<Encoder>(query_slots, &encoder, &error_params,
+                                    encryption_prng.get()));
+  ASSERT_OK_AND_ASSIGN(std::vector<Integer> fresh_decryption,
+                       secret_key.DecryptBfv<Encoder>(encrypted_query,
+                                                     &encoder));
+  ASSERT_EQ(fresh_decryption, query_slots);
+  ASSERT_OK_AND_ASSIGN(
+      NoiseStats fresh_noise,
+      MeasureNoise(encrypted_query, query_slots, secret_key, encoder, context,
+                   moduli));
+  ASSERT_EQ(fresh_noise.exact_rounding_mismatches, 0);
+
+  const int baby_power = 5;
+  const int giant_power = ModPow(5, kBabySteps, 2 * kN);
+  ASSERT_OK_AND_ASSIGN(
+      GaloisKey baby_key,
+      CreateRoundTrippedEvaluationKey(secret_key, baby_power, kBabyKeySeed,
+                                      &gadget, moduli));
+  ASSERT_OK_AND_ASSIGN(
+      GaloisKey giant_key,
+      CreateRoundTrippedEvaluationKey(secret_key, giant_power, kGiantKeySeed,
+                                      &gadget, moduli));
+  ASSERT_EQ(baby_key.Dimension(), kExpectedGadgetDimension);
+  ASSERT_EQ(giant_key.Dimension(), kExpectedGadgetDimension);
+
+  std::vector<Ciphertext> baby_ciphertexts;
+  std::vector<std::vector<Integer>> baby_plaintexts;
+  baby_ciphertexts.reserve(kBabySteps);
+  baby_plaintexts.reserve(kBabySteps);
+  baby_ciphertexts.push_back(encrypted_query);
+  baby_plaintexts.push_back(query_slots);
+  for (int i = 1; i < kBabySteps; ++i) {
+    ASSERT_OK_AND_ASSIGN(
+        Ciphertext rotated,
+        RotateWithPrecomputedPad(baby_ciphertexts.back(), baby_power, baby_key,
+                                 &gadget, moduli));
+    baby_ciphertexts.push_back(std::move(rotated));
+    baby_plaintexts.push_back(RotateSlotsLeft(baby_plaintexts.back(), 1));
+  }
+
+  // Exercise one complete response-block workload without allocating the
+  // 1 GiB database: 8 groups of 128 plaintext absorbs, then 7 giant rotations.
+  std::vector<Ciphertext> inner_products;
+  std::vector<std::vector<Integer>> inner_plaintexts;
+  inner_products.reserve(kGiantSteps);
+  inner_plaintexts.reserve(kGiantSteps);
+  constexpr int kFiveInverseMod2N = 3277;
+  for (int giant_id = 0; giant_id < kGiantSteps; ++giant_id) {
+    std::vector<Integer> expected(kN, 0);
+    Ciphertext accumulator = encrypted_query;
+    bool initialized = false;
+    const int diagonal_power =
+        ModPow(kFiveInverseMod2N, giant_id * kBabySteps, 2 * kN);
+    for (int baby_id = 0; baby_id < kBabySteps; ++baby_id) {
+      const std::vector<Integer> diagonal_slots =
+          BuildDiagonalSlots(giant_id, baby_id);
+      std::vector<Integer> unrotated_diagonal_slots(kN, 0);
+      const int diagonal = giant_id * kBabySteps + baby_id;
+      for (int k = 0; k < kSlotGroupSize; ++k) {
+        const int row = k % kRowsPerBlock;
+        const int first_column = (k + diagonal) % kSlotGroupSize;
+        if (first_column < kDataColumns) {
+          unrotated_diagonal_slots[k] = DataValue(row, first_column);
+        }
+        const int second_column =
+            (kRowsPerBlock / 2 + k + diagonal) % kSlotGroupSize;
+        if (second_column < kDataColumns) {
+          unrotated_diagonal_slots[kSlotGroupSize + k] =
+              DataValue(row, second_column);
+        }
+      }
+      ASSERT_OK_AND_ASSIGN(
+          Polynomial diagonal_polynomial,
+          encoder.EncodeBfv(unrotated_diagonal_slots, moduli,
+                            /*is_scaled=*/false));
+      ASSERT_OK_AND_ASSIGN(
+          Polynomial rotated_diagonal,
+          diagonal_polynomial.Substitute(diagonal_power, moduli));
+
+      if (!initialized) {
+        ASSERT_OK_AND_ASSIGN(accumulator,
+                             baby_ciphertexts[baby_id].AbsorbSimple(
+                                 rotated_diagonal));
+        initialized = true;
+      } else {
+        ASSERT_OK(accumulator.FusedAbsorbAddInPlace(
+            baby_ciphertexts[baby_id], rotated_diagonal));
+      }
+      FusedSlotMulAdd(&expected, baby_plaintexts[baby_id], diagonal_slots);
+    }
+    inner_products.push_back(std::move(accumulator));
+    inner_plaintexts.push_back(std::move(expected));
+  }
+
+  Ciphertext result = inner_products.back();
+  std::vector<Integer> expected_result = inner_plaintexts.back();
+  for (int giant_id = kGiantSteps - 2; giant_id >= 0; --giant_id) {
+    ASSERT_OK_AND_ASSIGN(
+        result,
+        RotateWithPrecomputedPad(result, giant_power, giant_key, &gadget,
+                                 moduli));
+    expected_result = RotateSlotsLeft(expected_result, kBabySteps);
+    ASSERT_OK(result.AddInPlace(inner_products[giant_id]));
+    for (int i = 0; i < kN; ++i) {
+      expected_result[i] =
+          static_cast<Integer>((absl::uint128(expected_result[i]) +
+                                inner_plaintexts[giant_id][i]) %
+                               kT);
+    }
+  }
+
+  ASSERT_OK_AND_ASSIGN(std::vector<Integer> decryption,
+                       secret_key.DecryptBfv<Encoder>(result, &encoder));
+  ASSERT_EQ(decryption, expected_result);
+
+  ASSERT_OK_AND_ASSIGN(
+      NoiseStats noise,
+      MeasureNoise(result, expected_result, secret_key, encoder, context,
+                   moduli));
+  const Uint256 modulus = Uint256(kQ0) * kQ1;
+  const Uint256 scaled_threshold = modulus / 2;
+  ASSERT_EQ(noise.exact_rounding_mismatches, 0);
+  ASSERT_LT(noise.max_scaled_abs, scaled_threshold);
+
+  const long double threshold_ld =
+      scaled_threshold.convert_to<long double>() / static_cast<long double>(kT);
+  const long double max_noise_ld =
+      noise.max_scaled_abs.convert_to<long double>() /
+      static_cast<long double>(kT);
+  const long double rms_noise_ld =
+      noise.scaled_rms / static_cast<long double>(kT);
+  const long double margin_bits = std::log2(threshold_ld / max_noise_ld);
+
+  // Original-style heuristic: model the final effective coefficients as
+  // independent centered Gaussians. Inflate the measured RMS to a one-sided
+  // 2^-64 variance-confidence bound using the Laurent-Massart chi-square
+  // inequality, then union-bound the normal tail over all N coefficients.
+  // This is explicitly an empirical Gaussian model, not a correctness proof.
+  constexpr long double kVarianceConfidenceBits = 64;
+  const long double confidence_x =
+      kVarianceConfidenceBits * std::log(2.0L);
+  const long double variance_denominator =
+      kN - 2.0L * std::sqrt(kN * confidence_x);
+  ASSERT_GT(variance_denominator, 0);
+  const long double sigma_upper =
+      std::max<long double>(1, rms_noise_ld) *
+      std::sqrt(kN / variance_denominator);
+  const long double x = threshold_ld / (std::sqrt(2.0L) * sigma_upper);
+  const long double log_noise_tail =
+      std::log(static_cast<long double>(kN)) - x * x - std::log(x) -
+      0.5L * std::log(std::acos(-1.0L));
+  const long double log_confidence_failure = -confidence_x;
+  const long double max_log_failure =
+      std::max(log_noise_tail, log_confidence_failure);
+  const long double log2_failure =
+      (max_log_failure +
+       std::log(std::exp(log_noise_tail - max_log_failure) +
+                std::exp(log_confidence_failure - max_log_failure))) /
+      std::log(2.0L);
+  constexpr long double kTargetLog2Failure = -40;
+
+  std::cout << std::fixed << std::setprecision(2)
+            << "[BFV_VALIDATION] Q_bits="
+            << std::log2(modulus.convert_to<long double>())
+            << " gadget_dimension=" << gadget.Dimension()
+            << " gadget_log_bases=" << kLogGadgetBase0 << ","
+            << kLogGadgetBase1
+            << " packing=PASS evaluation_keys=PASS rotations=PASS\n"
+            << "[BFV_VALIDATION] max_noise_bits="
+            << std::log2(max_noise_ld)
+            << " rms_noise_bits=" << std::log2(rms_noise_ld)
+            << " threshold_bits=" << std::log2(threshold_ld)
+            << " margin_bits=" << margin_bits << " noise_overflow=NO\n"
+            << "[BFV_VALIDATION] gaussian_model_log2_failure<="
+            << log2_failure << " target=" << kTargetLog2Failure
+            << " variance_confidence_bits=" << kVarianceConfidenceBits
+            << " model=empirical-gaussian\n";
+  ASSERT_LE(log2_failure, kTargetLog2Failure);
+}
+
